# Server-only Supabase credentials
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Browser-safe Vapi identifiers. These are delivered at runtime by /api/public-config.
VAPI_PUBLIC_KEY=YOUR_VAPI_PUBLIC_KEY
VAPI_ASSISTANT_ID=YOUR_SAM_ASSISTANT_ID

# Server-to-server authentication for the Vapi custom tool.
# Create a Vapi Custom Credential (Bearer token) with the same value.
VAPI_TOOL_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Protected operations mutations. Public portfolio deployments are read-only by default.
OPS_ACTION_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
APP_ORIGIN=https://your-project.vercel.app
DEMO_ALLOW_PUBLIC_WRITES=false
